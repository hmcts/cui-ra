{% extends "template.njk" %}

{% from "./macros/csrf.njk" import csrfProtection %}

{% if welsh === false %}
    {% set nameValue = 'name' %}
    {% set master_name = mastername %}
{% else %}
    {% set nameValue = 'name_cy' %}
    {% set master_name = mastername_cy %}
{% endif %}

{% block content %}
    <span class="govuk-caption-xl">{{ master_name }}</span>
    <h1 class="govuk-heading-xl">Invoker</h1>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half">


          {# IDAM token generation success #}
            {% if hasIdamToken %}
              <div
                class="govuk-notification-banner govuk-notification-banner--success"
                role="alert"
                aria-labelledby="idam-token-success-title">

                <div class="govuk-notification-banner__header">
                  <h2
                    class="govuk-notification-banner__title"
                    id="idam-token-success-title">
                    Success
                  </h2>
                </div>

                <div class="govuk-notification-banner__content">
                  <p class="govuk-notification-banner__heading">
                    IDAM token generated successfully
                  </p>
                </div>
              </div>
            {% endif %}

            <form action="/generate-idam-token" method="post">
              {{ csrfProtection(csrfToken) }}

              <button
                type="submit"
                class="govuk-button"
                data-module="govuk-button">
                Generate IDAM token
              </button>
            </form>



          <label for="journey" class="govuk-body govuk-!-font-weight-bold"> New Journey:</label>

          <form action="/start-invoker" method="get">


              <select class="govuk-body govuk-select" id="journey" name="journey" required>
                <option value="">-- Select a journey --</option>
                <option value="IA">Immigration and Asylum</option>
                <option value="CIVIL">Civil</option>
                <option value="PRIVATELAW">Private Law</option>
                <option value="PUBLICLAW">Public Law</option>
                <option value="SSCS">SSCS</option>
                <option value="ST_CIC">Special Tribunals</option>
                <option value="EMPLOYMENT">Employment</option>
                <option value="DIVORCE">Divorce</option>
                <option value="FR">Financial Remedy</option>
                <option value="PROBATE">Probate</option>
                <option value="PCS">Possession Claims Service</option>
              </select>

              <button type="submit" class="govuk-button" data-module="govuk-button">Start Invoker</button>

          </form>

        </div>
    </div>



{% endblock %}
