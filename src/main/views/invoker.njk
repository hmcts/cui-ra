{% extends "template.njk" %}

{% from "./macros/csrf.njk" import csrfProtection %}

{% if welsh === false %}
    {% set nameValue = 'name' %}
    {% set master_name = mastername %}
{% else %}
    {% set nameValue = 'name_cy' %}
    {% set master_name = mastername_cy %}
{% endif %}

{% block content %}
    <span class="govuk-caption-xl">{{ master_name }}</span>
    <h1 class="govuk-heading-xl">Invoker</h1>

    <p class="govuk-body">
        This is the invoker.
    </p>

    <form action="/start-invoker" method="get">
        <label for="journey" class="govuk-body govuk-!-font-weight-bold">Journey:</label>

        <select class="govuk-body" id="journey" name="journey" required>
          <option value="">-- Select a journey --</option>
          <option value="IA">Immigration and Asylum</option>
          <option value="CIVIL">Civil</option>
          <option value="PRIVATELAW">Private Law</option>
          <option value="PUBLICLAW">Public Law</option>
          <option value="SSCS">SSCS</option>
          <option value="ST_CIC">Special Tribunals</option>
          <option value="EMPLOYMENT">Employment</option>
          <option value="DIVORCE">Divorce</option>
          <option value="FR">Financial Remedy</option
          <option value="PROBATE">Probate</option>
          <option value="PCS">Possession Claims Service</option>
        </select>

        <button type="submit" class="govuk-button" data-module="govuk-button">Enter</button>
      </form>

{% endblock %}
